{
  "name": "open_savings_sub_account",
  "version": "1.0",
  "description": "Open a savings sub-account for an existing member.",

  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true
    }
  ],

  "steps": [
    {
      "id": "open_member_search",
      "action": "navigate",
      "value": "http://127.0.0.1:8000"
    },
    {
      "id": "enter_member_id",
      "action": "fill",
      "locator": {
        "strategy": "id",
        "value": "member_id"
      },
      "value": "{{member_id}}"
    },
    {
      "id": "search_member",
      "action": "click",
      "locator": {
        "strategy": "id",
        "value": "search-button"
      }
    },
    {
      "id": "open_sub_account",
      "action": "click",
      "locator": {
        "strategy": "id",
        "value": "open-account-button"
      }
    },
    {
      "id": "select_savings",
      "action": "click",
      "locator": {
        "strategy": "id",
        "value": "savings"
      }
    },
    {
      "id": "continue",
      "action": "click",
      "locator": {
        "strategy": "id",
        "value": "continue-button"
      }
    }
  ],

  "outputs": [
    {
      "name": "confirmation_message",
      "type": "string",
      "locator": {
        "strategy": "id",
        "value": "success-message"
      }
    }
  ],

  "success_condition": {
    "locator": {
      "strategy": "id",
      "value": "success-message"
    },
    "contains_text": "Account created successfully"
  }
}
